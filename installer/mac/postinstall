#!/bin/bash
# pkg postinstall (runs as root, once per component package; idempotent).
#
# Gives the logged-in user ownership of the installed bundles so the in-plugin updater can swap
# their Contents without admin rights. The parent folders (/Library/Audio/Plug-Ins/...) stay
# root-owned. Also strips quarantine and removes leftovers of earlier in-place updates.
#
# Arguments from Installer: $1 package path, $2 install location, $3 target volume.

target="${3:-/}"
target="${target%/}"

console_user="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)"
if [ -z "$console_user" ] || [ "$console_user" = "root" ] || [ "$console_user" = "loginwindow" ]; then
    console_user="$(echo "show State:/Users/ConsoleUser" | /usr/sbin/scutil 2>/dev/null \
        | /usr/bin/awk '/Name :/ && $3 != "loginwindow" { print $3; exit }')"
fi

for bundle in "$target/Library/Audio/Plug-Ins/VST3/BeatboxReplacer.vst3" \
              "$target/Library/Audio/Plug-Ins/Components/BeatboxReplacer.component"; do
    [ -d "$bundle" ] || continue

    /bin/rm -rf "$bundle"/Contents.old-* "$bundle"/Contents.new 2>/dev/null || true
    /usr/bin/xattr -dr com.apple.quarantine "$bundle" 2>/dev/null || true

    if [ -n "$console_user" ] && [ "$console_user" != "root" ] && /usr/bin/id -u "$console_user" >/dev/null 2>&1; then
        /usr/sbin/chown -R "$console_user" "$bundle" || true
        /bin/chmod -R u+rwX "$bundle" || true
    fi
done

# Let the system pick up the new Audio Unit without logging out.
/usr/bin/killall -9 AudioComponentRegistrar >/dev/null 2>&1 || true

exit 0
